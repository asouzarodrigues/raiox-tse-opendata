# --- Qual UF/anos esta rodada vai processar. Solte os arquivos da UF em
# data/raw/<dataset>/<ano>/ (ver README) e ajuste aqui antes de rodar. ---
UF=AC
UF_LOWER=ac
# Anos com arquivo em data/raw/ prontos pra carregar nesta rodada. Migração é
# incremental: a cada nova eleição (~2 em 2 anos) roda de novo só com o ano
# novo — não precisa reprocessar os anteriores.
ANOS="2024"

# --- Postgres: aponta pro schema `raiox` DE VERDADE (mesmo que o
# raiox-votos-node lê). Local (porta 15432, docker do raiox-migracao-piloto)
# por padrão — apontar isso pra VPS/produção real é decisão manual e
# deliberada, feita por fora deste .env.example (ver README). RAW_SCHEMA é
# só staging interno (CSV cru, tipado como texto) — nunca é lido pelo
# backend. ---
DATABASE_URL=postgresql://raiox:raiox_local_only@localhost:15432/raiox_piloto
RAW_SCHEMA=raiox_tse_raw

# --- scripts/04_promote.sh: promove UF/anos já transformados no piloto
# local pra PRODUÇÃO real do Neon. Connection string DIRECT (não pooled),
# NUNCA um branch de teste/simulação — o script recusa rodar se parecer
# uma dessas duas coisas. Deixe vazio se ainda não for promover nada. ---
PROD_DATABASE_URL=

# --- Origem dos arquivos ---
# cdn.tse.jus.br devolve 403 pra requests "de máquina" — mas não é bloqueio
# de IP: é o WAF (Akamai) exigindo a presença de headers de Client Hints
# (sec-ch-ua*, Sec-Fetch-*) que um Chrome real sempre manda. Confirmado em
# 2026-08-24 — scripts/01_download.sh já manda esses headers, direto no
# CDN, sem proxy nenhum (ver README). WAYBACK_PROXY fica só como fallback,
# não é mais o caminho padrão.
WAYBACK_PROXY=https://web.archive.org/web/2/
